{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LyricFlow default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/lyricflow-sidecar", "sidecar": true }]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/lyricflow-sidecar", "sidecar": true }]
    },
    "shell:allow-stdin-write"
  ]
}
