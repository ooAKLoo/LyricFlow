{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-ios/refs/heads/develop/nicegram-assistant/nicegram-assistant-react/src-tauri/gen/schemas/desktop-schema.json",
  "productName": "LyricFlow",
  "version": "0.1.0",
  "identifier": "com.lyricflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "LyricFlow",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 23 },
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/lyricflow-sidecar"],
    "resources": {
      "../../sidecar/*.py": "sidecar/",
      "../../backend/*.py": "backend/",
      "../../backend/pipeline/*.py": "backend/pipeline/",
      "../../backend/engine/*.py": "backend/engine/",
      "../../backend/engine/rules/*.py": "backend/engine/rules/",
      "../../backend/providers/*.py": "backend/providers/",
      "../../backend/data/*.json": "backend/data/",
      "../../backend/outputs/3a21ff04/result.json": "baby/result.json",
      "../../backend/outputs/3a21ff04/vocals.wav": "baby/vocals.wav",
      "../../backend/outputs/7d8f5921/original.wav": "baby/original.wav"
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": { "depends": [] },
      "appimage": { "bundleMediaFramework": true }
    },
    "category": "Education"
  }
}
