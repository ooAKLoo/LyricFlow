# LyricFlow never sends audio merely because credentials are configured.
# The user must also enable cloud analysis for each run in the app.

# Optional: reuse another env file instead of copying secrets into this project.
# LYRICFLOW_ENV_FILE=/absolute/path/to/services.env

# Volcengine flash ASR (new console uses VOLC_API_KEY; legacy console uses both below)
VOLC_API_KEY=
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
VOLC_FLASH_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
# If the account has no flash quota, LyricFlow automatically falls back here.
VOLC_STANDARD_ASR_RESOURCE_ID=volc.bigasr.auc

# Qwen Omni line-level pronunciation coach
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LYRICFLOW_AUDIO_COACH_MODEL=qwen3.5-omni-plus

# Optional lyrics providers
MUSIXMATCH_API_KEY=
GENIUS_API_KEY=
